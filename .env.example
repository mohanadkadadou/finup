# Server
PORT=4000
DATABASE_URL=postgres://localhost:5432/finup
TEST_DATABASE_URL=postgres://localhost:5432/finup_test
NODE_ENV=development
# Max upload size in megabytes
MAX_UPLOAD_MB=10
# Set to "true" only behind HTTPS so session cookies get the Secure flag
COOKIE_SECURE=false

# Public address of the web app, used in emailed links (reset / verify)
APP_URL=http://localhost:5173

# Email (Resend, https://resend.com). With a key, reset/verify links, sign-in codes and reports are really sent.
# MAIL_FROM must be an address on a domain verified in Resend; the default onboarding@resend.dev only delivers
# to the Resend account owner's own address (fine for a first test, not for real users).
RESEND_API_KEY=
MAIL_FROM=FinUp <onboarding@resend.dev>
# Require an emailed 6-digit code after the password. Defaults to true when RESEND_API_KEY is set.
LOGIN_CODES=

# AI assistant (optional). Without a key the assistant uses a deterministic fallback.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Bank provider (optional, none implemented). Placeholders for a future adapter.
BANK_PROVIDER=
BANK_PROVIDER_CLIENT_ID=
BANK_PROVIDER_CLIENT_SECRET=
BANK_PROVIDER_REDIRECT_URI=
